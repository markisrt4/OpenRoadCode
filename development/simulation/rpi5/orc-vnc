#!/usr/bin/env bash
set -euo pipefail
host="${ORC_VNC_HOST:-vps}"
case "${1:-}" in
    relay)
        exec ssh -T -o BatchMode=yes "$host" 'podman exec -i orc-rpi5-vnc python3 -u /workspace/development/simulation/rpi5/vnc-relay.py'
        ;;
    start)
        geometry="${2:-1280x720}"
        case "$geometry" in 1280x720|800x480) ;; *) exit 2 ;; esac
        if (($# >= 2)); then shift 2; else shift; fi
        for argument in "$@"; do
            case "$argument" in
                --simulation|--camera|--no-camera|--audio|--no-audio|--native-map|--no-native-map|--spotify|--no-spotify|--opengl|--no-opengl) ;;
                *) echo "Unsupported runtime argument: $argument" >&2; exit 2 ;;
            esac
        done
        ssh -T "$host" bash -s -- "$geometry" "$@" <<'REMOTE'
set -euo pipefail
geometry="$1"
shift
name=orc-rpi5-vnc
if podman container exists "$name"; then
    if [[ "$(podman inspect --format '{{.State.Running}}' "$name")" == true ]]; then
        actual="$(podman exec "$name" xdpyinfo -display :99 2>/dev/null | awk '/dimensions:/ {print $2; exit}' || true)"
        if [[ "$actual" == "$geometry" && $# -eq 0 ]]; then
            exit 0
        fi
        if [[ -z "$actual" ]]; then
            echo "Existing simulation display not ready; retry shortly." >&2
            exit 1
        fi
        podman stop --time 5 "$name"
    fi
    if podman container exists "$name"; then
        podman rm "$name"
    fi
fi
mkdir -p ~/.local/state/openroadcode
nohup bash ~/src/OpenRoadCode/development/simulation/rpi5/run-vnc.sh "$geometry" "$@" > ~/.local/state/openroadcode/vnc.log 2>&1 < /dev/null &
REMOTE
        for ((i=0; i<60; i++)); do
            if ssh -T "$host" 'podman exec orc-rpi5-vnc python3 -c "import socket; socket.create_connection((\"127.0.0.1\",5900),2).close()"' >/dev/null 2>&1; then
                exec "$0" connect
            fi
            echo "Waiting for VNC ($((i+1))/60)"
            sleep 2
        done
        ssh -T "$host" 'tail -40 ~/.local/state/openroadcode/vnc.log'
        exit 1
        ;;
    connect)
        command -v socat >/dev/null
        command -v vncviewer >/dev/null
        export DISPLAY="${DISPLAY:-:1}"
        socat TCP-LISTEN:5900,bind=127.0.0.1,reuseaddr,fork "EXEC:$0 relay" &
        relay_pid=$!
        trap 'kill "$relay_pid" 2>/dev/null || true' EXIT
        sleep 1
        kill -0 "$relay_pid"
        if [[ -n "${TERMUX_VERSION:-}" || "${PREFIX:-}" == *com.termux* ]]; then
            vncviewer 127.0.0.1::5900 &
            viewer_pid=$!
            trap 'kill "$viewer_pid" "$relay_pid" 2>/dev/null || true' EXIT
            am_bin="$(command -v am || true)"
            am_bin="${am_bin:-/system/bin/am}"
            if ! x11_launch_output="$("$am_bin" start --user 0 -n com.termux.x11/com.termux.x11.MainActivity 2>&1)"; then
                printf '%s\n' "$x11_launch_output" >&2
                echo "[!] Could not bring Termux:X11 to the foreground; open it manually." >&2
            fi
            wait "$viewer_pid"
        else
            vncviewer 127.0.0.1::5900
        fi
        ;;
    stop)
        ssh -T "$host" 'if podman container exists orc-rpi5-vnc; then if [ "$(podman inspect --format "{{.State.Running}}" orc-rpi5-vnc)" = true ]; then podman stop --time 5 orc-rpi5-vnc; fi; if podman container exists orc-rpi5-vnc; then podman rm orc-rpi5-vnc; fi; fi'
        ;;
    status)
        ssh -T "$host" 'podman ps --filter name=orc-rpi5-vnc'
        ;;
    logs)
        ssh -T "$host" 'tail -60 ~/.local/state/openroadcode/vnc.log'
        ;;
    *) echo "Usage: orc-vnc {start [1280x720|800x480] [runtime flags]|connect|stop|status|logs}" >&2; exit 2 ;;
esac
