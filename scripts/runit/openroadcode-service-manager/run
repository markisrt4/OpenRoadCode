#!/data/data/com.termux/files/usr/bin/bash
# SPDX-FileCopyrightText: 2026 Mark G. Russell
# SPDX-License-Identifier: MIT

set -euo pipefail

SCRIPT_PATH="$(readlink -f -- "${BASH_SOURCE[0]}")"
SERVICE_DIR="$(dirname -- "$SCRIPT_PATH")"
PROJECT_ROOT="$(cd -- "$SERVICE_DIR/../../.." && pwd)"

export PYTHONUNBUFFERED=1
if [[ -x "$PROJECT_ROOT/venv-termux/bin/python" ]]; then
    PYTHON="$PROJECT_ROOT/venv-termux/bin/python"
else
    PYTHON="python"
fi

cd "$PROJECT_ROOT"
exec "$PYTHON" -m services.termux.service_manager_http --host 127.0.0.1 --port 8768
