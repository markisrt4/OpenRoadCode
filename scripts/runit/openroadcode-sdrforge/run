#!/data/data/com.termux/files/usr/bin/bash
# SPDX-FileCopyrightText: 2026 Mark G. Russell
# SPDX-License-Identifier: MIT
# SDR acquisition belongs to Termux; Android authorizes USB handoff separately.
set -euo pipefail

PROJECT_ROOT="${PROJECT_ROOT:-$HOME/src/OpenRoadCode}"
SDRFORGE_ROOT="${SDRFORGE_ROOT:-$HOME/src/libSDRForge}"
PROFILE_FILE="$HOME/.config/openroadcode/service-profiles/openroadcode-sdrforge.env"
if [[ -f "$PROFILE_FILE" ]]; then
    # Written by the restricted local service manager.
    source "$PROFILE_FILE"
fi
PROFILE="${OPENROADCODE_RUNTIME_PROFILE:-simulated}"
case "$PROFILE" in
    simulated) SOURCE_ARGS=(--simulate --warmup 0) ;;
    local)
        echo "RTL-SDR requires Android-authorized USB handoff; refusing direct runit startup" >&2
        exit 2
        ;;
    *) echo "Unsupported SDRForge source profile: $PROFILE" >&2; exit 2 ;;
esac

if [[ ! -f "$SDRFORGE_ROOT/examples/live_transport_server.py" ||
      ! -f "$SDRFORGE_ROOT/scripts/run_radio_region_server.sh" ]]; then
    echo "Missing libSDRForge server or regional launcher at $SDRFORGE_ROOT" >&2
    exit 1
fi
cd "$SDRFORGE_ROOT"
export PYTHONUNBUFFERED=1
export PYTHONPATH="$SDRFORGE_ROOT/src${PYTHONPATH:+:$PYTHONPATH}"
exec bash "$SDRFORGE_ROOT/scripts/run_radio_region_server.sh" \
    python examples/live_transport_server.py "${SOURCE_ARGS[@]}"
