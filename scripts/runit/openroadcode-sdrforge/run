#!/data/data/com.termux/files/usr/bin/bash
# SPDX-License-Identifier: MIT
# Termux owns SDR acquisition. Android only controls the runit supervisor.
set -euo pipefail

PROJECT_ROOT="${PROJECT_ROOT:-$HOME/src/OpenRoadCode}"
SDRFORGE_ROOT="${SDRFORGE_ROOT:-$HOME/src/libSDRForge}"
PROFILE_FILE="$HOME/.config/openroadcode/service-profiles/openroadcode-sdrforge.env"
if [[ -f "$PROFILE_FILE" ]]; then
    # Generated by the restricted local service manager; only known profile values.
    source "$PROFILE_FILE"
fi
PROFILE="${OPENROADCODE_RUNTIME_PROFILE:-simulated}"
case "$PROFILE" in
    simulated) SOURCE_ARGS=(--simulate --warmup 0) ;;
    local) SOURCE_ARGS=(--warmup 0) ;;
    *) echo "Unsupported SDRForge source profile: $PROFILE" >&2; exit 2 ;;
esac

if [[ ! -f "$SDRFORGE_ROOT/examples/live_transport_server.py" ]]; then
    echo "Missing libSDRForge at $SDRFORGE_ROOT" >&2
    exit 1
fi
cd "$SDRFORGE_ROOT"
export PYTHONUNBUFFERED=1
export PYTHONPATH="$SDRFORGE_ROOT/src${PYTHONPATH:+:$PYTHONPATH}"
exec python examples/live_transport_server.py "${SOURCE_ARGS[@]}"
