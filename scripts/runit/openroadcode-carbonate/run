#!/data/data/com.termux/files/usr/bin/bash
# SPDX-License-Identifier: MIT
set -euo pipefail
SCRIPT_PATH="$(readlink -f -- "${BASH_SOURCE[0]}")"
PROJECT_ROOT="$(cd -- "$(dirname -- "$SCRIPT_PATH")/../../.." && pwd)"
PROFILE_FILE="$HOME/.config/openroadcode/service-profiles/openroadcode-carbonate.env"
if [[ -f "$PROFILE_FILE" ]]; then
    set -a
    source "$PROFILE_FILE"
    set +a
fi
cd "$PROJECT_ROOT"
exec sh "$PROJECT_ROOT/development/calendar/run_carbonate.sh"
