{
  "version": 8,
  "glyphs": "file:///srv/openroadcode/maps/glyphs/{fontstack}/{range}.pbf",
  "sources": {
    "openroad": {"type": "vector", "url": "mbtiles:///srv/openroadcode/maps/vector/openroadcode.mbtiles"},
    "route": {"type": "geojson", "data": {"type": "FeatureCollection", "features": []}},
    "vehicle": {"type": "geojson", "data": {"type": "FeatureCollection", "features": []}}
  },
  "layers": [
    {"id":"background","type":"background","paint":{"background-color":"#f1efe9"}},
    {"id":"landcover","type":"fill","source":"openroad","source-layer":"landcover","paint":{"fill-color":["match",["get","class"],"wood","#d9ead3","grass","#e8f1d4","scrub","#e7ecd8","farmland","#eee8cc","#ece8dc"],"fill-opacity":0.7}},
    {"id":"landuse","type":"fill","source":"openroad","source-layer":"landuse","paint":{"fill-color":["match",["get","class"],"residential","#e8e4df","commercial","#eadfd7","industrial","#e2ddd8","cemetery","#dfe8d7","hospital","#eadfe5","school","#e8e2cf","#e6e2dc"],"fill-opacity":0.6}},
    {"id":"parks","type":"fill","source":"openroad","source-layer":"park","minzoom":9,"paint":{"fill-color":"#d7ead0","fill-opacity":0.85}},
    {"id":"water","type":"fill","source":"openroad","source-layer":"water","paint":{"fill-color":"#a9d6ee"}},
    {"id":"waterways","type":"line","source":"openroad","source-layer":"waterway","minzoom":8,"paint":{"line-color":"#8dc7e8","line-width":["interpolate",["linear"],["zoom"],8,0.8,12,1.4,14,2.2]}},
    {"id":"boundaries","type":"line","source":"openroad","source-layer":"boundary","minzoom":4,"paint":{"line-color":"#b2aca4","line-width":["interpolate",["linear"],["zoom"],4,0.5,10,1.0,14,1.5],"line-dasharray":[3,3],"line-opacity":0.7}},

    {"id":"railways","type":"line","source":"openroad","source-layer":"transportation","minzoom":10,"filter":["in",["get","class"],["literal",["rail","transit"]]],"paint":{"line-color":"#aaa5a0","line-width":["interpolate",["linear"],["zoom"],10,0.8,14,1.8],"line-dasharray":[2,2],"line-opacity":0.8}},
    {"id":"service-roads","type":"line","source":"openroad","source-layer":"transportation","minzoom":13,"filter":["in",["get","class"],["literal",["service","path","track"]]],"paint":{"line-color":"#d6d1cb","line-width":["interpolate",["linear"],["zoom"],13,0.8,14,1.4]}},
    {"id":"residential-roads-casing","type":"line","source":"openroad","source-layer":"transportation","minzoom":11,"filter":["in",["get","class"],["literal",["minor","residential","living_street"]]],"paint":{"line-color":"#c9c4be","line-width":["interpolate",["linear"],["zoom"],11,1.6,14,4.5]}},
    {"id":"residential-roads","type":"line","source":"openroad","source-layer":"transportation","minzoom":11,"filter":["in",["get","class"],["literal",["minor","residential","living_street"]]],"paint":{"line-color":"#ffffff","line-width":["interpolate",["linear"],["zoom"],11,1.0,14,3.5]}},
    {"id":"secondary-roads-casing","type":"line","source":"openroad","source-layer":"transportation","minzoom":8,"filter":["in",["get","class"],["literal",["secondary","tertiary"]]],"paint":{"line-color":"#bdb7b0","line-width":["interpolate",["linear"],["zoom"],8,1.5,12,3.8,14,6.0]}},
    {"id":"secondary-roads","type":"line","source":"openroad","source-layer":"transportation","minzoom":8,"filter":["in",["get","class"],["literal",["secondary","tertiary"]]],"paint":{"line-color":"#f8f6f2","line-width":["interpolate",["linear"],["zoom"],8,0.9,12,2.8,14,4.8]}},
    {"id":"primary-roads-casing","type":"line","source":"openroad","source-layer":"transportation","minzoom":6,"filter":["==",["get","class"],"primary"],"paint":{"line-color":"#c5a97b","line-width":["interpolate",["linear"],["zoom"],6,1.8,10,4.0,14,7.0]}},
    {"id":"primary-roads","type":"line","source":"openroad","source-layer":"transportation","minzoom":6,"filter":["==",["get","class"],"primary"],"paint":{"line-color":"#f3d7a6","line-width":["interpolate",["linear"],["zoom"],6,1.2,10,3.0,14,5.8]}},
    {"id":"motorways-casing","type":"line","source":"openroad","source-layer":"transportation","minzoom":4,"filter":["in",["get","class"],["literal",["motorway","trunk"]]],"paint":{"line-color":"#b88b64","line-width":["interpolate",["linear"],["zoom"],4,2.0,9,4.8,14,8.5]}},
    {"id":"motorways","type":"line","source":"openroad","source-layer":"transportation","minzoom":4,"filter":["in",["get","class"],["literal",["motorway","trunk"]]],"paint":{"line-color":"#efb97d","line-width":["interpolate",["linear"],["zoom"],4,1.3,9,3.6,14,7.0]}},

    {"id":"aeroways","type":"line","source":"openroad","source-layer":"aeroway","minzoom":11,"paint":{"line-color":"#c9c9c9","line-width":["interpolate",["linear"],["zoom"],11,1.0,14,3.0]}},
    {"id":"buildings","type":"fill","source":"openroad","source-layer":"building","minzoom":13,"paint":{"fill-color":"#d0ccc7","fill-outline-color":"#b6b1ab"}},

    {"id":"route-line-casing","type":"line","source":"route","paint":{"line-color":"#ffffff","line-width":9,"line-opacity":0.95}},
    {"id":"route-line","type":"line","source":"route","paint":{"line-color":"#cc0000","line-width":6,"line-opacity":0.95}},

    {"id":"water-labels","type":"symbol","source":"openroad","source-layer":"water_name","minzoom":10,"layout":{"text-field":"{name:latin}","text-font":["KlokanTech Noto Sans CJK Regular"],"text-size":["interpolate",["linear"],["zoom"],10,11,14,14]},"paint":{"text-color":"#4d84a6","text-halo-color":"#eef8fc","text-halo-width":1.5}},
    {"id":"road-labels","type":"symbol","source":"openroad","source-layer":"transportation_name","minzoom":10,"layout":{"symbol-placement":"line","text-field":"{name:latin}","text-font":["KlokanTech Noto Sans CJK Regular"],"text-size":["interpolate",["linear"],["zoom"],10,11,14,14]},"paint":{"text-color":"#3a3733","text-halo-color":"#ffffff","text-halo-width":2}},
    {"id":"road-refs","type":"symbol","source":"openroad","source-layer":"transportation_name","minzoom":9,"filter":["has","ref"],"layout":{"symbol-placement":"line","text-field":"{ref}","text-font":["KlokanTech Noto Sans CJK Regular"],"text-size":10,"text-padding":18},"paint":{"text-color":"#6a543b","text-halo-color":"#fff8e8","text-halo-width":2}},
    {"id":"place-labels","type":"symbol","source":"openroad","source-layer":"place","minzoom":5,"layout":{"text-field":"{name:latin}","text-font":["KlokanTech Noto Sans CJK Regular"],"text-size":["interpolate",["linear"],["zoom"],5,11,9,14,14,17]},"paint":{"text-color":"#3e3b37","text-halo-color":"#f7f4ee","text-halo-width":2}},
    {"id":"aerodrome-labels","type":"symbol","source":"openroad","source-layer":"aerodrome_label","minzoom":10,"layout":{"text-field":"{name:latin}","text-font":["KlokanTech Noto Sans CJK Regular"],"text-size":12},"paint":{"text-color":"#666666","text-halo-color":"#ffffff","text-halo-width":1.5}},
    {"id":"mountain-peaks","type":"symbol","source":"openroad","source-layer":"mountain_peak","minzoom":11,"layout":{"text-field":"{name:latin}","text-font":["KlokanTech Noto Sans CJK Regular"],"text-size":11},"paint":{"text-color":"#6b6258","text-halo-color":"#f5f2eb","text-halo-width":1.5}},
    {"id":"poi-labels","type":"symbol","source":"openroad","source-layer":"poi","minzoom":13,"filter":["in",["get","class"],["literal",["hospital","school","college","university","fuel","grocery","restaurant","park","attraction"]]],"layout":{"text-field":"{name:latin}","text-font":["KlokanTech Noto Sans CJK Regular"],"text-size":11,"text-padding":8},"paint":{"text-color":"#5c5750","text-halo-color":"#ffffff","text-halo-width":1.5}},
    {"id":"house-numbers","type":"symbol","source":"openroad","source-layer":"housenumber","minzoom":14,"layout":{"text-field":"{housenumber}","text-font":["KlokanTech Noto Sans CJK Regular"],"text-size":9},"paint":{"text-color":"#817a72","text-halo-color":"#ffffff","text-halo-width":1}},

    {"id":"vehicle-blue-dot","type":"circle","source":"vehicle","filter":["==",["get","marker_mode"],"blue_dot"],"paint":{"circle-radius":["*",9,["get","marker_scale"]],"circle-color":"#0066ff","circle-stroke-color":"#ffffff","circle-stroke-width":3}},
    {"id":"vehicle-heading","type":"circle","source":"vehicle","filter":["==",["get","marker_mode"],"heading"],"paint":{"circle-radius":["*",8,["get","marker_scale"]],"circle-color":"#0066ff","circle-stroke-color":"#ffffff","circle-stroke-width":2}},
    {"id":"vehicle-veloster","type":"circle","source":"vehicle","filter":["==",["get","marker_mode"],"vehicle"],"paint":{"circle-radius":["*",10,["get","marker_scale"]],"circle-color":"#d71920","circle-stroke-color":"#ffffff","circle-stroke-width":3}}
  ]
}
