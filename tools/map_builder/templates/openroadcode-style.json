{
  "version": 8,
  "glyphs": "file:///srv/openroadcode/maps/glyphs/{fontstack}/{range}.pbf",
  "sources": {
    "openroad": {"type": "vector", "url": "mbtiles:///srv/openroadcode/maps/vector/openroadcode.mbtiles"},
    "route": {"type": "geojson", "data": {"type": "FeatureCollection", "features": []}},
    "vehicle": {"type": "geojson", "data": {"type": "FeatureCollection", "features": []}}
  },
  "layers": [
    {"id":"background","type":"background","paint":{"background-color":"#eeeeee"}},
    {"id":"landuse","type":"fill","source":"openroad","source-layer":"landuse","paint":{"fill-color":"#dddddd","fill-opacity":0.5}},
    {"id":"water","type":"fill","source":"openroad","source-layer":"water","paint":{"fill-color":"#9ecae1"}},
    {"id":"buildings","type":"fill","source":"openroad","source-layer":"building","minzoom":12,"paint":{"fill-color":"#bbbbbb","fill-outline-color":"#999999"}},
    {"id":"roads","type":"line","source":"openroad","source-layer":"transportation","paint":{"line-color":"#666666","line-width":2}},
    {"id":"major-roads","type":"line","source":"openroad","source-layer":"transportation","filter":["in",["get","class"],["literal",["motorway","trunk","primary"]]],"paint":{"line-color":"#333333","line-width":4}},
    {"id":"route-line","type":"line","source":"route","paint":{"line-color":"#cc0000","line-width":6,"line-opacity":0.9}},
    {"id":"vehicle-marker","type":"circle","source":"vehicle","paint":{"circle-radius":9,"circle-color":"#0066ff","circle-stroke-color":"#ffffff","circle-stroke-width":3}},
    {"id":"road-labels","type":"symbol","source":"openroad","source-layer":"transportation_name","minzoom":11,"layout":{"symbol-placement":"line","text-field":"{name:latin}","text-font":["KlokanTech Noto Sans CJK Regular"],"text-size":14},"paint":{"text-color":"#222222","text-halo-color":"#ffffff","text-halo-width":2}}
  ]
}
